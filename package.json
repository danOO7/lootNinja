{
  "name": "pydantic-ai-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:simple": "concurrently \"npm run dev:ui\" \"npm run dev:agent:simple\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "bash ./run-agent.sh",
    "dev:agent:simple": "bash ./run-agent-simple.sh",
    "dev:ui": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "install:agent": "sh ./scripts/setup-agent.sh || scripts\\setup-agent.bat",
    "postinstall": "npm run install:agent",
    "test:agent": "cd agent && python quick_test.py",
    "test:agent:unit": "cd agent && pytest test_agent.py -v -m unit",
    "test:agent:integration": "cd agent && pytest test_agent.py -v -m integration",
    "test:agent:all": "cd agent && pytest test_agent.py -v",
    "test:agent:coverage": "cd agent && pytest test_agent.py --cov=. --cov-report=html --cov-report=term-missing",
    "kill:ports": "lsof -ti:3000,8000,8001 | xargs -r kill -9 2>/dev/null; sleep 1; echo 'Ports cleaned'"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.10.6",
    "@copilotkit/react-ui": "^1.10.6",
    "@copilotkit/runtime": "^1.10.6",
    "@tavily/core": "^0.5.13",
    "ioredis": "^5.8.2",
    "next": "16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.9.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
